# 数据源选择：akshare（默认，免费无需注册）或 tushare
DATA_SOURCE=akshare

# Tushare Pro Token（DATA_SOURCE=tushare 时必填）
# 注册地址：https://tushare.pro/register
TUSHARE_TOKEN=your_token_here

SEND_KEY=your_key_here

# DeepSeek（OpenAI 兼容接口，LLM 因子生成）
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://your-deepseek-endpoint/v1
